{
  "name": "ng-cli-packagr-tasks",
  "version": "17.3.11",
  "description": "Angular CLI Build Architect for ng-packagr with custom tasks and workflows",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "builders": "builders.json",
  "scripts": {
    "build": "rm -rf dist && ./node_modules/.bin/tsc -p tsconfig.json && node publish-copy.mjs",
    "watch": "rm -rf dist && ./node_modules/.bin/tsc -w -p tsconfig.json"
  },
  "author": "Shlomi Assaf <shlomiasafk@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/shlomiassaf/ng-cli-packagr-tasks",
  "repository": {
    "type": "git",
    "url": "https://github.com/angularclass/ng-cli-packagr-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/shlomiassaf/ng-cli-packagr-tasks/issues"
  },
  "keywords": [
    "angular",
    "angular2",
    "angular4",
    "angular-library",
    "angular-components",
    "component-library",
    "typescript",
    "css",
    "scss",
    "html"
  ],
  "dependencies": {
    "globby": "^13.1.3"
  },
  "peerDependencies": {
    "@angular-devkit/build-angular": "^17.3.11",
    "ng-packagr": "^17.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.11",
    "@angular/cli": "~17.3.11",
    "@angular/compiler": "17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@types/node": "18.7.1",
    "@types/semver": "^7.0.0",
    "ng-packagr": "^17.3.0",
    "tslib": "^2.4.0",
    "typescript": "~5.4.5"
  }
}